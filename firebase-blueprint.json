{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Admin user profile",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "displayName"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "addedAt": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "admin"] }
      },
      "required": ["email"]
    },
    "Product": {
      "title": "Product",
      "description": "Educational notes or study material product",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 250 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "subject": { "type": "string", "maxLength": 100 },
        "classLevel": { "type": "string", "maxLength": 50 },
        "examTarget": { "type": "string", "maxLength": 100 },
        "medium": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "enum": ["Normal", "Premium", "Budget Friendly"] },
        "tags": { "type": "array" },
        "chapters": { "type": "array" },
        "coverImagePath": { "type": "string", "maxLength": 1000 },
        "pdfStoragePath": { "type": "string", "maxLength": 1000 },
        "driveFileLink": { "type": "string", "maxLength": 1000 },
        "pdfList": { "type": "array" },
        "fileType": { "type": "string", "maxLength": 50 },
        "pageCount": { "type": "number" },
        "originalPricePaise": { "type": "number" },
        "sellingPricePaise": { "type": "number" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "subject", "classLevel", "sellingPricePaise", "published"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "maxLength": 150 },
        "studentPhone": { "type": "string", "maxLength": 20 },
        "productId": { "type": "string", "maxLength": 128 },
        "productTitleSnapshot": { "type": "string", "maxLength": 250 },
        "amountPaise": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "paid", "failed", "refunded", "manually_approved"] },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "failedAt": { "type": "string" },
        "refundStatus": { "type": "string" },
        "failureReason": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string" },
        "archiveReason": { "type": "string" },
        "lastVerifiedWithRazorpayAt": { "type": "string" },
        "approvedByAdminEmail": { "type": "string" },
        "approvedByAdminUid": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvalRemark": { "type": "string" },
        "approvalMethod": { "type": "string", "enum": ["razorpay_automatic", "admin_manual"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "productId", "amountPaise", "status"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Student entitlement to download a specific note product",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "productTitle": { "type": "string", "maxLength": 250 },
        "coverImagePath": { "type": "string", "maxLength": 1000 },
        "driveFileLink": { "type": "string", "maxLength": 1000 },
        "pdfList": { "type": "array" },
        "entitlementStatus": { "type": "string", "enum": ["active", "revoked"] },
        "purchasedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "productId", "orderId", "entitlementStatus"]
    },
    "AppPublicSettings": {
      "title": "AppPublicSettings",
      "description": "Public branding, banner config, and social contact links",
      "type": "object",
      "properties": {
        "banner": { "type": "object" },
        "social": { "type": "object" },
        "contact": { "type": "object" },
        "announcement": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "FreeNote": {
      "title": "FreeNote",
      "description": "Free educational notes catalog for all five subjects. Publicly viewable.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 250 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "subject": { "type": "string", "maxLength": 100 },
        "chapterTopic": { "type": "string", "maxLength": 250 },
        "chapters": { "type": "array" },
        "classLevel": { "type": "string", "maxLength": 50 },
        "examTarget": { "type": "string", "maxLength": 100 },
        "medium": { "type": "string", "maxLength": 50 },
        "coverImagePath": { "type": "string", "maxLength": 1000 },
        "driveFileLink": { "type": "string", "maxLength": 1000 },
        "fileType": { "type": "string", "maxLength": 50 },
        "pageCount": { "type": "number" },
        "isFree": { "type": "boolean" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "subject", "driveFileLink", "published"]
    },
    "HomepageBanner": {
      "title": "HomepageBanner",
      "description": "Dynamic promotional banner shown in 16:9 ratio in the homepage hero slider",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "title": { "type": "string", "maxLength": 250 },
        "redirectUrl": { "type": "string", "maxLength": 1000 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["imageUrl", "displayOrder", "isActive", "createdAt"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Active student or admin device session record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "deviceType": { "type": "string", "enum": ["Android", "iOS", "Desktop", "Tablet", "Unknown"] },
        "browser": { "type": "string", "maxLength": 100 },
        "os": { "type": "string", "maxLength": 100 },
        "ipAddress": { "type": "string", "maxLength": 50 },
        "loginAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "userAgent": { "type": "string", "maxLength": 250 }
      },
      "required": ["uid", "deviceType", "status", "loginAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Immutable forensic audit trail of administrator actions",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["product", "order", "settings", "banner", "user", "system"] },
        "details": { "type": "object" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["adminUid", "adminEmail", "action", "targetType", "timestamp"]
    },
    "DownloadEvent": {
      "title": "DownloadEvent",
      "description": "Idempotent record of student PDF downloads",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productTitle": { "type": "string", "maxLength": 250 },
        "pdfId": { "type": "string", "maxLength": 128 },
        "pdfName": { "type": "string", "maxLength": 250 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 100 },
        "isFree": { "type": "boolean" },
        "downloadedAt": { "type": "string" },
        "device": { "type": "string", "maxLength": 50 }
      },
      "required": ["eventId", "productId", "userId", "downloadedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Student profile data restricted to the profile owner and admins"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Authoritative list of administrative users"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Notes and study material catalog. Published products are publicly viewable."
    },
    "/freeNotes/{freeNoteId}": {
      "schema": "FreeNote",
      "description": "Free educational chapter notes catalog for all subjects. Publicly accessible."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Payment and order records owned by user or verified by server/admin"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "User purchase entitlements. Users can list their own purchases."
    },
    "/archived_orders/{orderId}": {
      "schema": "Order",
      "description": "Financial audit archive for failed orders cleared after 30 days"
    },
    "/appSettings/public": {
      "schema": "AppPublicSettings",
      "description": "Public site banners, contact numbers, and social links"
    },
    "/homepage_banners/{bannerId}": {
      "schema": "HomepageBanner",
      "description": "Promotional banners displayed dynamically in the homepage hero slider"
    },
    "/admin_activity_logs/{logId}": {
      "schema": "AdminActivityLog",
      "description": "Immutable forensic audit trail of administrative actions"
    },
    "/user_sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Device and active session records"
    },
    "/download_events/{eventId}": {
      "schema": "DownloadEvent",
      "description": "Verified student PDF download events for analytics"
    }
  }
}
