rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muktar9085mkr@gmail.com'
      );
    }

    // Public covers and banners
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notes PDF files - strictly protected
    match /notes/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
