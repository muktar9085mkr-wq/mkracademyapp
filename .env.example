# Razorpay Configuration (Server-side ONLY - never expose Key Secret in frontend/VITE_ vars)
# Get Key ID and Key Secret from Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (Settings -> Webhooks) - DO NOT confuse with RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=

# Admin Configuration
ADMIN_EMAIL="muktar9085mkr@gmail.com"

# Optional Frontend API Base URL (ONLY needed if static dist/ is uploaded to Hostinger public_html
# while the Node.js / Netlify backend runs on a separate domain, e.g. https://api.mkracademy.in)
VITE_API_BASE_URL=

# YouTube Data API v3 (Server-side only — never expose in client VITE_ vars)
# Optional: if omitted, server automatically falls back to official channel RSS feed for @mkracademy01
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
