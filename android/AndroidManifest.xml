<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mkr.academy">

    <!-- Essential Internet & Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 
      CRITICAL FOR ANDROID 11+ (API 30+): 
      Declares package visibility queries so the WebView can detect and 
      launch installed UPI applications (Google Pay, PhonePe, Paytm, BHIM, Cred, etc.)
    -->
    <queries>
        <!-- Generic UPI intent scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>

        <!-- Google Pay specific scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tez" />
        </intent>

        <!-- PhonePe specific scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="phonepe" />
        </intent>

        <!-- Paytm specific schemes -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="paytmmp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="paytm" />
        </intent>

        <!-- BHIM UPI specific scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bhim" />
        </intent>

        <!-- Specific UPI App Packages for Intent resolution -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />  <!-- Google Pay -->
        <package android:name="com.phonepe.app" />                         <!-- PhonePe -->
        <package android:name="net.one97.paytm" />                         <!-- Paytm -->
        <package android:name="in.org.npci.upiapp" />                      <!-- BHIM -->
        <package android:name="com.whatsapp" />                            <!-- WhatsApp Pay -->
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MKR Academy"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking support -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ais-dev-thkxnkewcmofcvdrlseylg-476803681048.asia-southeast1.run.app" />
            </intent-filter>
        </activity>
    </application>

</manifest>
