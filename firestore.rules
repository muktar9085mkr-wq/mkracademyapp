rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'muktar9085mkr@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: Protected from unauthorized inspection
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Users profile: PII protection, owner or admin only, no privilege self-escalation
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'uid', 'status', 'isVerified', 'suspendedReason', 'blockedReason']))
      );
      allow delete: if isAdmin();
    }

    // Products catalog: Publicly readable for all educational materials; write restricted to Admin
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Free Notes catalog: Publicly readable for all educational materials; write restricted to Admin
    match /freeNotes/{freeNoteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders collection: Students can only read/list their own orders; Admins can read/manage all
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        orderId.size() > 0 && orderId.size() <= 128 &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.productId is string && request.resource.data.productId.size() > 0 &&
        request.resource.data.amountPaise is number && request.resource.data.amountPaise > 0;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.amountPaise == resource.data.amountPaise &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'razorpayPaymentId',
          'razorpayOrderId',
          'razorpaySignature',
          'verifiedAt',
          'updatedAt',
          'failedAt',
          'failureReason',
          'approvalMethod'
        ]) &&
        (
          (
            request.resource.data.status == 'paid' &&
            resource.data.status in ['pending', 'failed', 'paid'] &&
            request.resource.data.razorpayPaymentId is string &&
            request.resource.data.razorpayPaymentId.size() >= 8 &&
            request.resource.data.razorpayPaymentId.size() <= 128 &&
            request.resource.data.razorpayOrderId is string &&
            request.resource.data.razorpayOrderId.size() >= 8 &&
            request.resource.data.razorpayOrderId.size() <= 128 &&
            (!('razorpayOrderId' in resource.data) || resource.data.razorpayOrderId == '' || request.resource.data.razorpayOrderId == resource.data.razorpayOrderId) &&
            request.resource.data.razorpaySignature is string &&
            request.resource.data.razorpaySignature.matches('^[a-f0-9]{64}$')
          ) ||
          (
            request.resource.data.status == 'failed' &&
            resource.data.status in ['pending', 'failed']
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Archived Orders: Long-term financial audit records for failed orders cleared after 30 days
    match /archived_orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Purchases entitlements:
    // Students can read/list their own purchases (and check existence of pur_{uid}_{productId} before creation).
    // Purchase creation requires either Admin approval OR a verified 'paid' or 'manually_approved' order in database.
    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn() &&
        purchaseId.size() > 0 && purchaseId.size() <= 128 && purchaseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.id == purchaseId &&
        request.resource.data.productId is string && request.resource.data.productId.size() > 0 &&
        request.resource.data.orderId is string && request.resource.data.orderId.size() > 0 &&
        request.resource.data.entitlementStatus == 'active' &&
        request.resource.data.paymentStatus == 'PAID' &&
        request.resource.data.razorpayPaymentId is string && request.resource.data.razorpayPaymentId.size() >= 8 &&
        request.resource.data.razorpayOrderId is string && request.resource.data.razorpayOrderId.size() >= 8 &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['paid', 'manually_approved'] &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productId == request.resource.data.productId &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.razorpayPaymentId == request.resource.data.razorpayPaymentId &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.razorpayOrderId == request.resource.data.razorpayOrderId
      );
      allow update, delete: if isAdmin();
    }

    // Public app settings (banners, social links, contact info)
    match /appSettings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Promotional Banners (16:9 dynamic slider)
    match /homepage_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Activity Logs: Immutable, append-only forensic audit trail
    // Admin can read and create; NO ONE (not even admin) can update or delete!
    match /admin_activity_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // User Sessions: Device and active session tracking
    match /user_sessions/{sessionId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Download Events: Idempotent student PDF download tracking and analytics
    match /download_events/{eventId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    function isValidHomepageMedia(data) {
      return data.keys().hasOnly([
          'title', 'contentType', 'contentUrl', 'videoId',
          'thumbnailUrl', 'publishedAt', 'displayOrder',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && !('description' in data)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.contentType in ['youtube', 'google_drive']
        && data.contentUrl is string && data.contentUrl.size() > 0 && data.contentUrl.size() <= 1000
        && (!('videoId' in data) || (data.videoId is string && data.videoId.size() <= 128))
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000
        && (!('publishedAt' in data) || data.publishedAt is string)
        && data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 9999
        && data.isActive is bool
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // Homepage Media Carousel items (Google Drive & YouTube): Active items public, write restricted to Admin
    match /homepage_media/{mediaId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update: if isAdmin() && mediaId.size() <= 128 && isValidHomepageMedia(request.resource.data);
      allow delete: if isAdmin();
    }

    // Cached YouTube latest uploads feed: Publicly readable cache, write restricted to Admin
    match /youtube_feed_cache/{cacheId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidRazorpayVerificationLog(data) {
      return data.keys().hasAll([
          'logId', 'uid', 'userEmail', 'attemptType', 'status',
          'failureCode', 'failureReason', 'orderId', 'productId',
          'razorpayOrderId', 'razorpayPaymentId', 'rawInputString',
          'generatedSignature', 'receivedSignature', 'signaturesMatch',
          'matchedWebhookSecretInstead', 'keyIdConfigured', 'keyIdPrefix',
          'keyMode', 'keySecretLength', 'payloadFormat', 'alreadyProcessed',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'logId', 'uid', 'userEmail', 'attemptType', 'status',
          'failureCode', 'failureReason', 'orderId', 'productId',
          'razorpayOrderId', 'razorpayPaymentId', 'rawInputString',
          'generatedSignature', 'receivedSignature', 'signaturesMatch',
          'matchedWebhookSecretInstead', 'keyIdConfigured', 'keyIdPrefix',
          'keyMode', 'keySecretLength', 'payloadFormat', 'alreadyProcessed',
          'createdAt'
        ])
        && data.logId is string && data.logId.size() > 0 && data.logId.size() <= 128 && data.logId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() > 0 && data.uid.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 150
        && data.attemptType in ['checkout_verify', 'webhook_verify']
        && data.status in ['verified', 'failed']
        && data.failureCode is string && data.failureCode.size() <= 80
        && data.failureReason is string && data.failureReason.size() <= 500
        && data.orderId is string && data.orderId.size() <= 128
        && data.productId is string && data.productId.size() <= 128
        && data.razorpayOrderId is string && data.razorpayOrderId.size() <= 128
        && data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 128
        && data.rawInputString is string && data.rawInputString.size() <= 300
        && data.generatedSignature is string && data.generatedSignature.size() <= 256
        && data.receivedSignature is string && data.receivedSignature.size() <= 256
        && data.signaturesMatch is bool
        && data.matchedWebhookSecretInstead is bool
        && data.keyIdConfigured is bool
        && data.keyIdPrefix is string && data.keyIdPrefix.size() <= 32
        && data.keyMode in ['live', 'test', 'missing', 'unknown']
        && data.keySecretLength is number && data.keySecretLength >= 0 && data.keySecretLength <= 512
        && data.payloadFormat in ['snake_case', 'camelCase', 'mixed', 'missing']
        && data.alreadyProcessed is bool
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    // Razorpay Signature Verification Diagnostic Logs:
    // Appended during authenticated verification attempts under caller UID;
    // ONLY administrators can inspect logs (prevents HMAC signature oracle abuse).
    match /razorpay_verification_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && logId.size() > 0 && logId.size() <= 128 && logId.matches('^[a-zA-Z0-9_\\-]+$')
        && request.resource.data.logId == logId
        && request.resource.data.uid == request.auth.uid
        && isValidRazorpayVerificationLog(request.resource.data);
      allow update, delete: if false;
    }
  }
}

